# Code generated by tooling normally. Written by hand here to record the
# same metadata a real `kubebuilder init` + `kubebuilder create api` would,
# since neither could be run without network access to download the
# kubebuilder binary itself in this sandbox.
domain: shivansh-sinha.dev
layout:
  - go.kubebuilder.io/v4
projectName: ephemeral-credential-broker
repo: github.com/shivansh-sinha/ephemeral-credential-broker
resources:
  - api:
      crdVersion: v1
      namespaced: true
    controller: true
    domain: shivansh-sinha.dev
    group: broker
    kind: EphemeralCredential
    path: github.com/shivansh-sinha/ephemeral-credential-broker/api/v1alpha1
    version: v1alpha1
version: "3"
